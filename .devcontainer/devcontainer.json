{
  "name": "Interview Prep",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Interview Prep",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 0.0.0.0 >/tmp/interview-prep.log 2>&1 &"
}
